{
  "name": "pynault-browser",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Pynault browser — Graphite + Lime",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron apps/desktop/main.cjs",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron apps/desktop/main.cjs\"",
    "desktop:dist": "npm run build && electron-builder",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npm run build && node scripts/install-native.mjs && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:apk": "npm run build && node scripts/install-native.mjs && npx cap sync android && node scripts/build-apk.mjs",
    "mobile:apk": "npm run build && node scripts/install-native.mjs && npx cap sync android && node scripts/build-apk.mjs",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/source-check.mjs && npm test"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.pynault.browser",
    "productName": "Pynault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "apps/desktop/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "main": "apps/desktop/main.cjs"
}
